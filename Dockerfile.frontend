# ==============================================================================
# CivicFix Municipal Platform — Frontend Dockerfile
# Multi-stage production build: Node.js 20 Vite compiler -> Nginx Alpine Web Server
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build React 19 + Vite Static Assets
# ------------------------------------------------------------------------------
FROM node:20-alpine AS build

WORKDIR /app

# Copy dependency specifications for layer caching
COPY package.json package-lock.json* bun.lock* ./

# Install build dependencies
RUN npm ci --prefer-offline --no-audit

# Copy application configuration and source code
COPY tsconfig.json vite.config.ts index.html ./
COPY src/ ./src/
COPY public/ ./public/

# Build static assets (outputs to /app/dist)
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 2: Production Nginx Server
# ------------------------------------------------------------------------------
FROM nginx:1.27-alpine AS production

# Install curl for health checking
RUN apk add --no-cache curl

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled frontend assets from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Copy custom reverse proxy & SPA configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Set permissions for nginx cache directories
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid

# Expose standard web port
EXPOSE 80

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/healthz || exit 1

# Run nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
