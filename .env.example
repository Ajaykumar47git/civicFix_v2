# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# PORT: Server listening port (default 3000)
PORT=3000

# DATABASE_URL: PostgreSQL connection string with PostGIS
DATABASE_URL=

# REDIS_URL: Redis connection URL for caching and rate limiting
REDIS_URL=

# JWT_SECRET: Minimum 32-character secret key for signing HMAC-SHA256 JWT tokens
JWT_SECRET=

# JWT_EXPIRATION: Access token lifespan (e.g., 900s or 15m)
JWT_EXPIRATION=900s

# REFRESH_TOKEN_SECRET: Secret key for signing long-lived refresh tokens
REFRESH_TOKEN_SECRET=

# REFRESH_TOKEN_EXPIRATION: Refresh token lifespan (e.g., 7d)
REFRESH_TOKEN_EXPIRATION=7d

# CORS_ORIGIN: Allowed origins for Cross-Origin Resource Sharing
CORS_ORIGIN=
